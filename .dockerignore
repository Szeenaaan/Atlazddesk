# Explicit build-context allowlist: no secrets, uploads, Git history or local tools.
**
!backend-overlay/
!backend-overlay/artisan
!backend-overlay/composer.json
!backend-overlay/composer.lock
!backend-overlay/app/
!backend-overlay/app/**
!backend-overlay/bootstrap/
!backend-overlay/bootstrap/app.php
!backend-overlay/bootstrap/providers.php
!backend-overlay/config/
!backend-overlay/config/**
!backend-overlay/database/
!backend-overlay/database/migrations/
!backend-overlay/database/migrations/**
!backend-overlay/database/seeders/
!backend-overlay/database/seeders/**
!backend-overlay/public/
!backend-overlay/public/index.php
!backend-overlay/resources/
!backend-overlay/resources/**
!backend-overlay/routes/
!backend-overlay/routes/**
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/index.html
!frontend/src/
!frontend/src/**
!infra/
!infra/docker/
!infra/docker/**
**/.env*
**/*.backup*
**/*.bak*
**/*.log
**/*.key
**/*.pem
**/auth.json

# Reject scratch/backup files even inside an allowed source directory.
**/*~
**/*.orig
**/*.rej
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*.p12
**/*.pfx
**/.DS_Store
**/Thumbs.db
**/playwright-report/**
**/test-results/**
**/blob-report/**
