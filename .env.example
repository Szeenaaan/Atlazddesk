# Compose substitution only: no application secrets here.
# Keep COMPOSE_PROJECT_NAME unchanged after installation; it identifies data volumes.
COMPOSE_PROJECT_NAME=atlazddesk
RELEASE=1.0.0
PUBLIC_HOST=support.example.com
APP_ORIGIN=https://support.example.com
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
