# Nonsecret deployment paths. Keep existing project name, env file and volumes.
SUPPORTDESK_PROJECT_DIR=/srv/amc-platform
SUPPORTDESK_COMPOSE_FILE=/srv/amc-platform/compose.yaml
SUPPORTDESK_COMPOSE_ENV_FILE=/srv/amc-platform/.env
SUPPORTDESK_IMAGE_OVERRIDE=/etc/supportdesk/images.compose.yaml
# Replace owner/repository with the lowercase GitHub repository path.
SUPPORTDESK_APP_IMAGE=ghcr.io/owner/repository/app:tested
SUPPORTDESK_WEB_IMAGE=ghcr.io/owner/repository/web:tested
SUPPORTDESK_ORIGIN=https://support.example.com
SUPPORTDESK_UPDATE_STATE_DIR=/var/lib/supportdesk-updates
