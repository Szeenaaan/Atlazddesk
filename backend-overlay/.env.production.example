APP_NAME="Atlazddesk"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://support.example.com
APP_KEY=
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=amc_platform
DB_USERNAME=amc_platform_user
DB_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
# Keep existing cookie/cache namespaces stable when updating the product display name.
SESSION_COOKIE=amc-platform-session
CACHE_PREFIX=amc-platform-cache-
REDIS_PREFIX=amc-platform-database-
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CORS_ALLOWED_ORIGINS=https://support.example.com
SANCTUM_STATEFUL_DOMAINS=support.example.com
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=support@example.com
MAIL_FROM_NAME="Atlazddesk"
AMC_SLA_WARNING_MINUTES=30
AMC_CONTRACT_WARNING_DAYS=30
AMC_SLOW_QUERY_MS=500
AMC_SLOW_REQUEST_MS=1000
AMC_MAX_UPLOAD_KB=10240
AMC_ATTACHMENTS_ENABLED=false
AMC_SMS_ENABLED=false
AMC_SMS_PROVIDER=
AMC_SMS_API_KEY=
AMC_SMS_TEMPLATE_ID=

AMC_SEED_DEMO_USERS=false
