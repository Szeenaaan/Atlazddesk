# Secrets and local environment files; retain sanitized configuration examples.
.env
.env.*
!.env.example
!.env.*.example
/auth.json
**/auth.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
/.aws/
/.codex/
/.agents/

# Installed dependencies and generated build artifacts.
**/node_modules/
**/vendor/
/frontend/dist/
/backend-overlay/public/build/
/backend-overlay/public/hot
/backend-overlay/public/storage
*.tsbuildinfo
coverage/
.phpunit.cache/
.phpunit.result.cache
__pycache__/
*.py[cod]

# Laravel runtime state, logs, sessions, caches and uploaded user files.
/backend-overlay/bootstrap/cache/*
!/backend-overlay/bootstrap/cache/.gitignore
/backend-overlay/storage/**
!/backend-overlay/storage/**/
!/backend-overlay/storage/**/.gitignore
*.log
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.sql
*.sql.gz

# Backups, archives and historical generated release bundles (keep local copies).
/.amc*-backup-*/
*.bak
*.bak-*
*.backup
*.backup-*
*~
*.orig
*.rej
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
/release-evidence/

# Machine-specific tools and editor state.
.DS_Store
Thumbs.db
.idea/
.vscode/
.fleet/
.nova/
.zed/
.phpactor.json
*.swp
*.swo
*.tmp
*.temp

# Local history, notes, evidence and archived patch installers are never published.
/notes/local/

# Per-installation Docker configuration, certificates and backup artifacts.
/installation/
/backups/

# Local environment loaders, browser test output, and database backup artifacts.
.envrc
.envrc.*
**/playwright-report/
**/test-results/
**/blob-report/
*.dump
*.sql.bz2
*.sql.xz
*.rdb

# Per-installation credential/configuration files, even if copied outside installation/.
**/access.json
**/app.env
**/database.env
**/redis.env
**/compose.env
**/updates.env

# Local tool caches and Python test output.
/.cache/
/.npm/
/frontend/.vite/
.pytest_cache/
